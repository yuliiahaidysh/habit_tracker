# ---- Server ----
# Port the Express API + WebSocket server listens on
PORT=4000

# SQLite database file (relative to server/prisma). Used by Prisma.
DATABASE_URL="file:./dev.db"

# URL of the frontend (used for CORS + post-login redirect)
CLIENT_URL=http://localhost:5173

# Public URL of this server (used to build OAuth callback URLs)
SERVER_URL=http://localhost:4000

# Secret used to sign the session cookie. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Timezone used to determine "today" for check-ins and streaks (IANA name).
# All check-in dates are stored as YYYY-MM-DD calendar dates in this zone.
APP_TZ=UTC

# ---- Google OAuth ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {SERVER_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- GitHub OAuth ----
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: {SERVER_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Test mode ----
# When set to 1, mounts POST /auth/test-login which logs in a stubbed user
# without contacting Google/GitHub. Used by the automated tests. Keep OFF (unset) in production.
AUTH_TEST_MODE=0
